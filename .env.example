# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEGH-AI Platform Integration Variables
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_USE_MOCK_DATA="false"

# Supabase & PostgreSQL (Server-side only)
SUPABASE_URL="https://arfyypisxkqxbwtacjbf.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
DATABASE_URL=""

# External Satellite, Reanalysis & Elevation Feeds
IMDAA_REANALYSIS_BASE_URL="https://imdaa.ncmrwf.gov.in/api/v1"
MOSDAC_INSAT_BASE_URL="https://mosdac.gov.in/api/v1"
SATELLITE_QPE_BASE_URL="https://mosdac.gov.in/api/qpe"
DEM_SERVICE_BASE_URL="https://bhuvan.nrsc.gov.in/cartodem"
MODEL_INFERENCE_URL=""

# Operational Severe Weather Thresholds
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
RISK_HIGH_THRESHOLD="50"
RISK_CRITICAL_THRESHOLD="75"
CAPE_SEVERE_THRESHOLD_JKG="2000"
IWV_CLOUDBURST_THRESHOLD_KGM2="55"
CTT_DROP_RATE_ALERT_C_PER_MIN="-8"
ENABLE_FEED_SIMULATION="true"
ENABLE_SATELLITE="true"
